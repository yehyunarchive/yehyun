<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Klavier cadenZa.</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css">
<style>
  :root {
    --bg: #fff;
    --fg: #000;
    --line: #000;
    --chip-bg: #000;
    --chip-fg: #fff;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { background: var(--bg); color: var(--fg); }
  body {
    font-family: 'Pretendard', -apple-system, 'Apple SD Gothic Neo', sans-serif;
    letter-spacing: -0.7px;
    line-height: 1.3;
    -webkit-text-size-adjust: none;
    text-size-adjust: none;
    font-synthesis: weight;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 16px;
  }

  /* PC·모바일 동일 너비(고정) */
  .wrap { width: 280px; max-width: 100%; text-align: left; flex: none; }

  .page { display: none; }
  .page.active { display: block; }

  .panel { max-height: 70vh; max-height: 70dvh; overflow-y: auto; padding: 6px 0 16px; }

  /* 볼드 */
  b, strong, .bold { font-weight: 700; }

  /* 하이라이트 칩 */
  .chip { background: var(--chip-bg); color: var(--chip-fg); padding: 0 4px; font-weight: 500; }
  .chip b, b .chip, .chip.bold { font-weight: 700; }
  .box { border: 0; border-bottom: 1px solid var(--line); padding: 0; }
  .ul { border-bottom: 1px solid var(--line); }

  /* 리스트 페이지 */
  .head { font-size: 12px; font-weight: 500; margin-bottom: 10px; }
  .head sup { font-size: 7px; font-weight: 400; }
  .intro { font-size: 9.5px; line-height: 1.3; margin-bottom: 10px; }
  .intro .box { font-size: 9.5px; }

  .tracks { border-top: 1px solid var(--line); }
  .track {
    display: flex; align-items: center; gap: 12px;
    padding: 6px 5px; border-bottom: 1px solid var(--line);
    cursor: pointer; font-size: 10.5px;
  }
  .track .no {
    background: var(--chip-bg); color: var(--chip-fg);
    border-radius: 999px; font-size: 8px; font-weight: 700;
    padding: 2px 7px;
  }
  .track .name { flex: 1; }
  .track .time { font-size: 9px; }
  .track:last-child { border-bottom: 0; }
  .page[data-page="0"] .panel { padding-bottom: 0; }
  body[data-p="0"] .nav { margin-top: 0; }

  /* 트랙 페이지 */
  .t-head { display: flex; align-items: center; gap: 10px; margin-bottom: 5px; }
  .t-head .no {
    background: var(--chip-bg); color: var(--chip-fg);
    border-radius: 999px; font-size: 8px; font-weight: 700; padding: 2px 7px;
  }
  .t-head h2 { flex: 1; font-size: 14px; font-weight: 700; }
  .t-head .time { font-size: 9px; }
  .term { font-size: 9px; margin-bottom: 8px; }

  .p { font-size: 10px; margin-bottom: 3px; }
  .p.gap { margin-bottom: 8px; }
  .p small { font-size: 7.5px; vertical-align: super; }
  .indent { padding-left: 20px; }
  .indent2 { padding-left: 56px; }
  .ml { display: block; margin-left: 20px; }

  .rows { margin-top: 7px; }
  .row { display: flex; gap: 10px; margin-bottom: 3px; font-size: 10px; }
  .row .who { flex: none; width: 74px; }
  .row .who span { background: var(--chip-bg); color: var(--chip-fg); padding: 1px 5px; font-weight: 500; }
  .row .chars { flex: 1; }

  /* 하단 네비 */
  .nav {
    display: flex; justify-content: space-between; align-items: center;
    border-top: 1px solid var(--line); margin-top: 7px; padding-top: 12px;
    font-size: 9.5px;
  }
  .nav button {
    background: none; border: 0; color: var(--fg); font: inherit;
    letter-spacing: inherit; cursor: pointer; padding: 2px 0;
  }
  .nav .mid { font-weight: 500; }
  .nav button:disabled { opacity: .3; cursor: default; }
</style>
</head>
<body>
